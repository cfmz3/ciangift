/* ========== CIAN GIFT — СТИЛИ ========== */
/* Тёмный изумрудно-золотой, без ИИ-ощущения */

@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400;600&display=swap');

:root {
    --bg-deep: #0a0c0b;
    --bg-hall: #1a1f1c;
    --gold: #c9a96e;
    --gold-light: #e0c78a;
    --gold-dark: #8b6914;
    --emerald: #0d5c3b;
    --emerald-dark: #063620;
    --red-felt: #1a4a2e;
    --text-light: #e8e0d5;
    --text-dim: #9a9484;
    --accent-red: #8b1a1a;
    --panel-bg: rgba(10, 12, 11, 0.95);
    --border-gold: 1px solid #c9a96e55;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: var(--bg-deep);
    color: var(--text-light);
    font-family: 'Montserrat', sans-serif;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
}

#app {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}

/* ========== ХОЛЛ ========== */
.scene {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
}
.scene.active {
    opacity: 1;
    pointer-events: auto;
}

#hall {
    background: radial-gradient(ellipse at center, #1a2a20 0%, #0a0f0c 70%);
}

/* Параллакс слои */
.parallax-bg {
    position: absolute;
    width: 110%;
    height: 110%;
    top: -5%;
    left: -5%;
    transition: transform 0.1s ease-out;
}
#parallax-layer-1 {
    background: 
        radial-gradient(circle at 20% 40%, #c9a96e11 0%, transparent 40%),
        radial-gradient(circle at 70% 60%, #c9a96e08 0%, transparent 50%);
}
#parallax-layer-2 {
    background: 
        radial-gradient(circle at 50% 30%, #0d5c3b22 0%, transparent 35%),
        radial-gradient(circle at 30% 70%, #c9a96e0a 0%, transparent 45%);
}

/* Пол холла */
#hall-floor {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 55%;
    background: linear-gradient(180deg, 
        #0a0f0c 0%, 
        #1a1508 5%, 
        #2a1f0a 50%, 
        #1a1005 100%);
    border-top: 2px solid #c9a96e33;
    box-shadow: 0 -20px 60px rgba(0,0,0,0.8) inset;
}

/* Игровые столы */
#hall-tables {
    position: absolute;
    bottom: 5%;
    width: 100%;
    height: 50%;
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    padding: 0 5%;
}

.table-spot {
    position: relative;
    width: 18%;
    height: 60%;
    cursor: pointer;
    transition: transform 0.3s ease, filter 0.3s ease;
    filter: brightness(0.8);
}
.table-spot:active {
    transform: scale(0.95);
    filter: brightness(1.2);
}
.table-spot::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10%;
    width: 80%;
    height: 50%;
    background: radial-gradient(ellipse, #1a3a20 0%, #0a1508 100%);
    border-radius: 50%;
    border: 2px solid #c9a96e44;
    box-shadow: 0 0 30px #0d5c3b33, 0 0 60px #000;
}
.table-glow {
    position: absolute;
    bottom: 10%;
    left: 20%;
    width: 60%;
    height: 30%;
    background: radial-gradient(ellipse, #c9a96e22 0%, transparent 70%);
    border-radius: 50%;
    animation: glow-pulse 3s ease-in-out infinite;
}
@keyframes glow-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
}
.table-label {
    position: absolute;
    bottom: 60%;
    width: 100%;
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: clamp(10px, 1.5vw, 14px);
    color: var(--gold-light);
    text-shadow: 0 0 10px #c9a96e44;
    letter-spacing: 1px;
    z-index: 2;
}

/* Пьедестал колеса */
#wheel-pedestal {
    position: absolute;
    right: 3%;
    bottom: 8%;
    width: 20%;
    height: 35%;
}

/* ========== ТОП-БАР ========== */
#top-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 50px;
    background: linear-gradient(180deg, var(--panel-bg), transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    z-index: 100;
}
#btn-menu, #btn-chat {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: var(--border-gold);
    background: rgba(10,12,11,0.8);
    color: var(--gold);
    font-size: 18px;
    cursor: pointer;
    backdrop-filter: blur(10px);
}
#balance-display {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    color: var(--gold-light);
    background: rgba(10,12,11,0.8);
    padding: 8px 16px;
    border-radius: 20px;
    border: var(--border-gold);
    backdrop-filter: blur(10px);
}

/* ========== МЕНЮ ========== */
#side-menu {
    position: fixed;
    left: -280px;
    top: 0;
    width: 260px;
    height: 100%;
    background: var(--panel-bg);
    border-right: 2px solid #c9a96e33;
    z-index: 200;
    padding: 20px 15px;
    transition: left 0.3s ease;
    backdrop-filter: blur(20px);
    overflow-y: auto;
}
#side-menu.open {
    left: 0;
}
#menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}
#menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
}
#menu-close {
    font-size: 28px;
    color: var(--gold);
    cursor: pointer;
    text-align: right;
    margin-bottom: 10px;
}
#menu-logo {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: var(--gold-light);
    text-align: center;
    margin-bottom: 25px;
    letter-spacing: 3px;
    text-shadow: 0 0 20px #c9a96e44;
}
.menu-btn {
    display: block;
    width: 100%;
    padding: 12px 15px;
    margin-bottom: 5px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-light);
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    text-align: left;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
}
.menu-btn:hover, .menu-btn:active {
    background: rgba(201,169,110,0.1);
    border-color: var(--gold);
    color: var(--gold-light);
}
hr {
    border: none;
    border-top: 1px solid #c9a96e22;
    margin: 10px 0;
}

/* ========== ИГРОВЫЕ ЭКРАНЫ ========== */
.game-screen {
    position: absolute;
    inset: 0;
    padding-top: 50px;
    background: var(--bg-deep);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    overflow-y: auto;
    z-index: 10;
}
.game-screen.active {
    opacity: 1;
    pointer-events: auto;
}
.btn-back {
    position: fixed;
    top: 56px;
    left: 10px;
    background: rgba(10,12,11,0.8);
    border: var(--border-gold);
    color: var(--gold);
    padding: 8px 14px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 13px;
    z-index: 150;
    backdrop-filter: blur(10px);
}

/* ========== ЧАТ ========== */
#chat-panel {
    position: fixed;
    right: -320px;
    bottom: 0;
    width: 300px;
    height: 60%;
    background: var(--panel-bg);
    border-left: 2px solid #c9a96e33;
    border-top: 2px solid #c9a96e33;
    border-radius: 16px 0 0 0;
    z-index: 150;
    display: flex;
    flex-direction: column;
    transition: right 0.3s ease;
    backdrop-filter: blur(20px);
}
#chat-panel.open {
    right: 0;
}
#chat-header {
    padding: 12px;
    font-family: 'Playfair Display', serif;
    color: var(--gold);
    border-bottom: 1px solid #c9a96e22;
    display: flex;
    justify-content: space-between;
}
#chat-close {
    cursor: pointer;
}
#chat-messages {
    flex: 1;
    padding: 10px;
    overflow-y: auto;
    font-size: 12px;
}
.chat-msg {
    margin-bottom: 8px;
    padding: 6px 10px;
    background: rgba(255,255,255,0.03);
    border-radius: 8px;
    border-left: 2px solid var(--gold);
    animation: msg-in 0.3s ease;
}
@keyframes msg-in {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
}
.chat-user {
    color: var(--gold-light);
    font-weight: 600;
    font-size: 11px;
}
.chat-text {
    color: var(--text-dim);
}
#chat-input-area {
    display: flex;
    padding: 8px;
    gap: 5px;
    border-top: 1px solid #c9a96e22;
}
#chat-input {
    flex: 1;
    background: rgba(255,255,255,0.05);
    border: 1px solid #c9a96e33;
    color: var(--text-light);
    padding: 8px 12px;
    border-radius: 20px;
    font-size: 13px;
    outline: none;
}
#chat-send {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--emerald);
    border: none;
    color: var(--gold-light);
    cursor: pointer;
    font-size: 16px;
}

/* ========== ОБЩИЕ КОМПОНЕНТЫ ========== */
/* Кнопки */
.btn-gold {
    background: linear-gradient(180deg, #c9a96e 0%, #8b6914 100%);
    border: none;
    color: #1a1005;
    padding: 12px 28px;
    border-radius: 25px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(201,169,110,0.3);
    transition: all 0.2s ease;
}
.btn-gold:active {
    transform: scale(0.96);
    box-shadow: 0 2px 8px rgba(201,169,110,0.5);
}

/* Суммы ставок */
.bet-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
}
.chip {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    transition: all 0.2s ease;
    border: 3px solid;
}
.chip-10 {
    background: #2a4a8a;
    border-color: #4a7acf;
    color: #aac4f0;
}
.chip-50 {
    background: #8a3a2a;
    border-color: #cf5a4a;
    color: #f0baaa;
}
.chip-100 {
    background: #2a6a3a;
    border-color: #4acf5a;
    color: #aaf0ba;
}
.chip-500 {
    background: #3a1a3a;
    border-color: #8a4a8a;
    color: #daaada;
}
.chip-1000 {
    background: #5a4a0a;
    border-color: #c9a96e;
    color: #f0da8a;
}
.chip.selected {
    transform: scale(1.15);
    box-shadow: 0 0 20px #c9a96e88;
    border-color: var(--gold-light);
}

/* Анимация выигрыша */
.win-flash {
    animation: win-glow 0.6s ease-out;
}
@keyframes win-glow {
    0% { filter: brightness(2); }
    100% { filter: brightness(1); }
}
.win-particles {
    position: fixed;
    pointer-events: none;
    z-index: 300;
}
.particle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold-light);
    animation: particle-fly 1s ease-out forwards;
}
@keyframes particle-fly {
    0% {
        opacity: 1;
        transform: translate(0, 0) scale(1);
    }
    100% {
        opacity: 0;
        transform: translate(var(--dx), var(--dy)) scale(0);
    }
}

/* Скроллбар */
::-webkit-scrollbar {
    width: 4px;
}
::-webkit-scrollbar-track {
    background: transparent;
}
::-webkit-scrollbar-thumb {
    background: #c9a96e44;
    border-radius: 2px;
}

/* Сообщение о выигрыше */
.win-toast {
    position: fixed;
    top: 60px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #1a3a20, #0d5c3b);
    border: 2px solid var(--gold);
    color: var(--gold-light);
    padding: 10px 24px;
    border-radius: 25px;
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    z-index: 250;
    animation: toast-in 0.4s ease, toast-out 0.4s ease 1.5s forwards;
}
@keyframes toast-in {
    from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
}
@keyframes toast-out {
    from { opacity: 1; }
    to { opacity: 0; }
}
